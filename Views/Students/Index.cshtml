@model IEnumerable<周末作业1.Models.ApplicationUser>
@{
    ViewData["Title"] = "学生列表";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>学生列表</h1>
        <p class="text-muted mb-0">所有已注册并拥有 Student 角色的用户。</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <span class="badge text-bg-danger">Admin 模式</span>
    }
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>姓名</th>
                <th>邮箱</th>
                <th>注册状态</th>
                @if (User.IsInRole("Admin"))
                {
                    <th class="text-end">操作</th>
                }
            </tr>
        </thead>
        <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.FirstName @student.LastName</td>
                <td>@student.Email</td>
                <td><span class="badge text-bg-success">Student</span></td>
                @if (User.IsInRole("Admin"))
                {
                    <td class="text-end">
                        <form asp-action="Delete" method="post" onsubmit="return confirm('确定删除此学生吗？');">
                            <input type="hidden" name="id" value="@student.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">删除</button>
                        </form>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
</div>
