@model 周末作业1.Models.CreateUserViewModel
@{
    ViewData["Title"] = "创建用户";
}

<div class="dashboard-heading">
    <div>
        <span class="eyebrow">Admin / 用户管理</span>
        <h1>创建用户</h1>
        <p>由 Admin 创建账户并直接选择用户角色。</p>
    </div>
    <a asp-action="Users" class="dashboard-action">返回用户列表 <span>→</span></a>
</div>

<section class="panel create-user-panel">
    <div class="panel-header">
        <div>
            <h2>账户信息</h2>
            <p>只有 Admin 可以打开此页面。</p>
        </div>
        <span class="badge text-bg-danger">Admin only</span>
    </div>
    <form asp-action="CreateUser" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
                <small class="text-muted">至少 8 位并包含数字和大写字母。</small>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-4">
            <label asp-for="Role" class="form-label"></label>
            <select asp-for="Role" class="form-select">
                <option value="Student">Student - 普通学生</option>
                <option value="Admin">Admin - 管理员</option>
            </select>
            <span asp-validation-for="Role" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">创建用户</button>
            <a asp-action="Users" class="btn btn-outline-secondary">取消</a>
        </div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
